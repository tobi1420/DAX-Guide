Actual = 
VAR _10000_OMSAETNING = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "10000_OMSÆTNING"),'GL Account'[Amount])
VAR _20000_VAREFORBRUG = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "20000_VAREFORBRUG"),'GL Account'[Amount])
VAR _30000_PROJEKTOMKOSTNINGER = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "30000_PROJEKTOMKOSTNINGER"),'GL Account'[Amount])
VAR _40000_PERSONALEOMKOSTNINGER = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "40000_PERSONALEOMKOSTNINGER"),'GL Account'[Amount])
VAR _50000_MARKEDSFORINGSOMKOSTNINGER = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "50000_MARKEDSFØRINGSOMKOSTNINGER"),'GL Account'[Amount])
VAR _60000_AUTODRIFTPERSONBILER = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "60000_AUTODRIFT PERSONBILER"),'GL Account'[Amount])
VAR _70000_VAREBILER = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "70000_VAREBILER"),'GL Account'[Amount])
VAR _80000_MASKINER = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "80000_MASKINER"),'GL Account'[Amount])
VAR _90000_LOKALEOMKOSTNINGER = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "90000_LOKALEOMKOSTNINGER"),'GL Account'[Amount])
VAR _100000_ADMINISTRATIONSOMKOSTNINGER = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "100000_ADMINISTRATIONSOMKOSTNINGER"),'GL Account'[Amount])
VAR _130000_AFSKRIVNINGER = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "130000_AFSKRIVNINGER"),'GL Account'[Amount])
VAR _140000_FINANSIELLEINDTAEGTER = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "140000_FINANSIELLE INDTÆGTER"),'GL Account'[Amount])
VAR _150000_FINANSIELLEUDGIFTER = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "150000_FINANSIELLE UDGIFTER"),'GL Account'[Amount])
VAR _160000_SKATTER = SUMX(CALCULATETABLE('GL Account',ALL('GL Account'),'GL Account'[Account Schedule Line No Name] = "160000_SKATTER"),'GL Account'[Amount])

VAR _25000_BRUTTORESULTAT = _10000_OMSAETNING + _20000_VAREFORBRUG 
VAR _105000_EBITDA = _10000_OMSAETNING + _20000_VAREFORBRUG + _30000_PROJEKTOMKOSTNINGER + _40000_PERSONALEOMKOSTNINGER + _50000_MARKEDSFORINGSOMKOSTNINGER + _60000_AUTODRIFTPERSONBILER + _70000_VAREBILER + _80000_MASKINER + _90000_LOKALEOMKOSTNINGER + _100000_ADMINISTRATIONSOMKOSTNINGER
VAR _135000_EBIT = _10000_OMSAETNING + _20000_VAREFORBRUG + _30000_PROJEKTOMKOSTNINGER + _40000_PERSONALEOMKOSTNINGER + _50000_MARKEDSFORINGSOMKOSTNINGER + _60000_AUTODRIFTPERSONBILER + _70000_VAREBILER + _80000_MASKINER + _90000_LOKALEOMKOSTNINGER + _100000_ADMINISTRATIONSOMKOSTNINGER + _130000_AFSKRIVNINGER
VAR _155000_RESULTATFORSKAT =     _10000_OMSAETNING + _20000_VAREFORBRUG + _30000_PROJEKTOMKOSTNINGER + _40000_PERSONALEOMKOSTNINGER + _50000_MARKEDSFORINGSOMKOSTNINGER + _60000_AUTODRIFTPERSONBILER + _70000_VAREBILER + _80000_MASKINER + _90000_LOKALEOMKOSTNINGER + _100000_ADMINISTRATIONSOMKOSTNINGER + _130000_AFSKRIVNINGER + _140000_FINANSIELLEINDTAEGTER + _150000_FINANSIELLEUDGIFTER
VAR _165000_ARETSRESULTAT  = _10000_OMSAETNING + _20000_VAREFORBRUG + _30000_PROJEKTOMKOSTNINGER + _40000_PERSONALEOMKOSTNINGER + _50000_MARKEDSFORINGSOMKOSTNINGER + _60000_AUTODRIFTPERSONBILER + _70000_VAREBILER + _80000_MASKINER + _90000_LOKALEOMKOSTNINGER + _100000_ADMINISTRATIONSOMKOSTNINGER + _130000_AFSKRIVNINGER + _140000_FINANSIELLEINDTAEGTER + _150000_FINANSIELLEUDGIFTER + _160000_SKATTER
VAR _166000_DAEKNINGSBIDRAG = _10000_OMSAETNING + _20000_VAREFORBRUG + _30000_PROJEKTOMKOSTNINGER + _40000_PERSONALEOMKOSTNINGER + _50000_MARKEDSFORINGSOMKOSTNINGER + _60000_AUTODRIFTPERSONBILER + _70000_VAREBILER + _80000_MASKINER + _90000_LOKALEOMKOSTNINGER + _100000_ADMINISTRATIONSOMKOSTNINGER + _130000_AFSKRIVNINGER + _140000_FINANSIELLEINDTAEGTER + _150000_FINANSIELLEUDGIFTER
VAR _167000_OVERSKUDSGRAD = _10000_OMSAETNING + _20000_VAREFORBRUG + _30000_PROJEKTOMKOSTNINGER + _40000_PERSONALEOMKOSTNINGER + _50000_MARKEDSFORINGSOMKOSTNINGER + _60000_AUTODRIFTPERSONBILER + _70000_VAREBILER + _80000_MASKINER + _90000_LOKALEOMKOSTNINGER + _100000_ADMINISTRATIONSOMKOSTNINGER + _130000_AFSKRIVNINGER + _140000_FINANSIELLEINDTAEGTER + _150000_FINANSIELLEUDGIFTER + _160000_SKATTER

VAR _actual = CALCULATE(SUMX('GL Account','GL Account'[Amount]))

RETURN
SWITCH(
    TRUE(),
    SELECTEDVALUE('GL Account'[Account Schedule Line No Name]) = 
    "25000_BRUTTORESULTAT", _25000_BRUTTORESULTAT,

    SELECTEDVALUE('GL Account'[Account Schedule Line No Name]) = 
    "25100_BRUTTORESULTAT (%)", ABS(DIVIDE(_20000_VAREFORBRUG, _10000_OMSAETNING) * 100),

    SELECTEDVALUE('GL Account'[Account Schedule Line No Name]) = 
    "105000_EBITDA", _105000_EBITDA,

    SELECTEDVALUE('GL Account'[Account Schedule Line No Name]) = 
    "106000_EBITDA (%)", ABS(DIVIDE(_105000_EBITDA, _10000_OMSAETNING) * 100),

    SELECTEDVALUE('GL Account'[Account Schedule Line No Name]) = 
    "135000_EBIT", _135000_EBIT,

    SELECTEDVALUE('GL Account'[Account Schedule Line No Name]) = 
    "136000_EBIT (%)", ABS(DIVIDE(_135000_EBIT, _10000_OMSAETNING) * 100),

    SELECTEDVALUE('GL Account'[Account Schedule Line No Name]) = 
    "155000_RESULTAT FØR SKAT", _155000_RESULTATFORSKAT,

    SELECTEDVALUE('GL Account'[Account Schedule Line No Name]) = 
    "165000_ÅRETS RESULTAT", _165000_ARETSRESULTAT,

    SELECTEDVALUE('GL Account'[Account Schedule Line No Name]) = 
    "166000_DÆKNINGSBIDRAG", ABS(DIVIDE(_166000_DAEKNINGSBIDRAG, _10000_OMSAETNING)* 100),

    SELECTEDVALUE('GL Account'[Account Schedule Line No Name]) = 
    "167000_OVERSKUDSGRAD",
    ABS(DIVIDE(_167000_OVERSKUDSGRAD, _10000_OMSAETNING) * 100),

    _actual
)